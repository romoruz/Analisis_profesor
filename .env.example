# Copia este archivo a .env (que está en .gitignore) y llena SOLO las llaves que uses.
# La capa LLM (litellm) elige el proveedor por el prefijo del modelo.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelos por rol (puedes mezclar proveedores). Ejemplos; revisa los nombres vigentes.
AP_MODELO_EXTRACCION=anthropic/claude-sonnet-5-5     # visión: fotos/PDF escaneado -> LaTeX
AP_MODELO_ETIQUETADO=anthropic/claude-sonnet-5-5     # arquetipo, rasgos, Bloom/DOK
AP_MODELO_GENERACION=anthropic/claude-opus-5-5       # ejercicios nuevos
AP_MODELO_BARATO=anthropic/claude-haiku-5-5          # tareas simples / segunda opinión

# Varias corridas por ítem para medir acuerdo del etiquetado (fase 4)
AP_REPETICIONES_ETIQUETADO=3
AP_CACHE_DIR=.llm_cache
